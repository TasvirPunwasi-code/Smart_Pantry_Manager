<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#245C43"
        android:paddingBottom="20dp" />

    <EditText
        android:id="@+id/edtIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name (e.g. Tomato)"
        android:inputType="textCapSentences"
        android:singleLine="true" />

    <EditText
        android:id="@+id/edtQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g. 5)"
        android:inputType="numberDecimal"
        android:singleLine="true" />

    <EditText
        android:id="@+id/edtUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (e.g. pieces, g, ml)"
        android:inputType="textCapSentences"
        android:singleLine="true" />

    <EditText
        android:id="@+id/edtExpiryDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry date (optional: YYYY-MM-DD)"
        android:inputType="date"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnSaveIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Ingredient"
        android:layout_marginTop="24dp" />

</LinearLayout>
