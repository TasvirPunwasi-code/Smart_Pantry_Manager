<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#245C43"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your ingredients and reduce food waste."
        android:textSize="15sp"
        android:textColor="#555555"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Ingredient" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#245C43"
        android:paddingTop="24dp"
        android:paddingBottom="12dp" />


    <TextView
        android:id="@+id/txtEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Add your first ingredient!"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="24dp" />

    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DDDDDD"
        android:dividerHeight="1dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="visible" />


    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings" />

</LinearLayout>
